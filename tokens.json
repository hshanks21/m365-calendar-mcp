{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Compact private calendar operations, charcoal surfaces and warm orange accents.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.929,
          0.651,
          0.427
        ],
        "hex": "#eda66d"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.125,
          0.129,
          0.118
        ],
        "hex": "#20211e"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.149,
          0.153,
          0.137
        ],
        "hex": "#262723"
      }
    },
    "section": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.106,
          0.11,
          0.098
        ],
        "hex": "#1b1c19"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.933,
          0.925,
          0.89
        ],
        "hex": "#eeece3"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.69,
          0.69,
          0.643
        ],
        "hex": "#b0b0a4"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.267,
          0.275,
          0.239
        ],
        "hex": "#44463d"
      }
    },
    "sage": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.741,
          0.792,
          0.608
        ],
        "hex": "#bdca9b"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "control": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Cormorant Garamond",
        "fontSize": {
          "value": 36,
          "unit": "px"
        },
        "fontWeight": 600
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Cormorant Garamond",
        "fontSize": {
          "value": 22,
          "unit": "px"
        },
        "fontWeight": 600
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Rubik",
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "control": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Rubik",
        "fontSize": {
          "value": 14,
          "unit": "px"
        }
      }
    },
    "technical": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Grotesk",
        "fontSize": {
          "value": 12,
          "unit": "px"
        }
      }
    },
    "mast": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Grotesk",
        "fontSize": {
          "value": 11,
          "unit": "px"
        }
      }
    }
  }
}
