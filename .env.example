# Names-only reference. Real secrets: dedicated Doppler runtime injection, not this file.
# Required even when M365 is not configured; independent random viewer key:
CALENDAR_DASHBOARD_SECRET=
# Nonsecret optional path (default var/telemetry.json):
# CALENDAR_TELEMETRY_FILE=
# Microsoft mode is mandatory if any CALENDAR_M365_* variable is injected.
# App-only example below; omit this entire namespace for Google/dashboard-only.
# Do not inject both Microsoft auth namespaces. See M365_RUNTIME.md.
CALENDAR_M365_MODE=app-only
CALENDAR_M365_TENANT_ID=
CALENDAR_M365_CLIENT_ID=
CALENDAR_M365_CLIENT_SECRET=
CALENDAR_M365_POLICY_FILE=
# Alternative to POLICY_FILE (never set both):
# CALENDAR_M365_POLICY_JSON=

# Alternative confidential Microsoft namespace (omit all app-only keys above):
# CALENDAR_M365_MODE=delegated-confidential
# CALENDAR_M365_DELEGATED_TENANT_ID=
# CALENDAR_M365_DELEGATED_CLIENT_ID=
# CALENDAR_M365_DELEGATED_ACCOUNT_OBJECT_ID=
# CALENDAR_M365_DELEGATED_CLIENT_SECRET=
# CALENDAR_M365_DELEGATED_MSAL_CACHE=
# CALENDAR_M365_DELEGATED_POLICY_JSON=

# Optional dashboard HTTPS (omit all three to retain HTTP loopback defaults).
# Set only after independent review; no wildcard/public/DNS bind is accepted.
# CALENDAR_DASHBOARD_BIND_ADDRESS=192.168.2.40
# CALENDAR_DASHBOARD_TLS_CERT_FILE=/absolute/path/to/server-cert.pem
# CALENDAR_DASHBOARD_TLS_KEY_FILE=/absolute/path/to/server-key.pem
# Cert/key must be paired, valid for bind IP; key permissions 0600.
